# Copia este fichero a .env y rellena los valores. .env nunca se sube al repositorio.

# Base de datos local (docker-compose)
PLANNER_DB_URL=jdbc:postgresql://127.0.0.1:5432/planner
PLANNER_DB_USER=planner
PLANNER_DB_PASSWORD=change-me

# Clave para cifrar la cookie de sesión y las credenciales SMTP (32 bytes en base64)
# Genera una con: openssl rand -base64 32
PLANNER_SECRET_KEY=

# Canvas
PLANNER_CANVAS_BASE_URL=https://aula.uoc.edu
# ID del semestre actual (enrollment_term_id); los cursos de otros semestres se excluyen
PLANNER_CANVAS_TERM_ID=220

# API de Claude (solo para el extractor, fase 1)
ANTHROPIC_API_KEY=
PLANNER_EXTRACTION_MODEL=claude-sonnet-5-5

# Correo (fase 1). Con Gmail, usa una contraseña de aplicación.
PLANNER_SMTP_HOST=smtp.gmail.com
PLANNER_SMTP_PORT=587
PLANNER_SMTP_USER=
PLANNER_SMTP_PASSWORD=
PLANNER_MAIL_TO_UOC=
PLANNER_MAIL_TO_PERSONAL=
