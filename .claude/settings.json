{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./mvnw:*)",
      "Bash(mvn:*)",
      "Bash(make test)",
      "Bash(make up)",
      "Bash(make down)",
      "Bash(make fixtures)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs:*)",
      "Bash(npm run:*)",
      "Bash(npm install)",
      "Bash(swift build:*)",
      "Bash(swift test:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(python3 scripts/anonymize_fixtures.py:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(make login)",
      "Bash(make sync)",
      "Bash(docker compose down:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./data/**)",
      "Read(./**/*.cookie)",
      "Read(./backend/src/test/resources/fixtures/raw/**)",
      "Bash(curl:*aula.uoc.edu*)",
      "Bash(wget:*)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
